# ---- LLM providers ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=anthropic

# Model tiers used by app/llm/router.py
MODEL_SMALL=claude-haiku-4-5-20251001
MODEL_MEDIUM=claude-sonnet-5
MODEL_LARGE=claude-opus-5

# ---- Tools ----
TAVILY_API_KEY=

# ---- Infrastructure ----
POSTGRES_DSN=postgresql+psycopg://arp:arp@localhost:5432/arp
ANALYTICS_DSN=postgresql+psycopg://arp_readonly:arp@localhost:5432/arp
REDIS_URL=redis://localhost:6379/0
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ---- Behaviour ----
CONFIDENCE_AUTO_APPROVE=0.85
CONFIDENCE_ESCALATE_BELOW=0.60
MAX_REPLAN_ATTEMPTS=2
